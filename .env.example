# --- Supabase -----------------------------------------------------------
# Project Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Never expose to the browser. Used by scripts/seeding only.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI -----------------------------------------------------------------
# Powers campaign copy, caption generation, and client reply drafting.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Integrations -------------------------------------------------------
# All integrations run against mock adapters until these are set AND
# LENSELLO_INTEGRATION_MODE=live. See packages/core/src/integrations/README.md
LENSELLO_INTEGRATION_MODE="mock"   # mock | live

# Meta (Instagram Graph API + Marketing API) - requires a Business account
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# Google (Gmail for the client inbox, Calendar for gigs)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Stripe (deposits + invoices for gigs)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
