# Every environment variable Lensello reads, with a slot for each.
#
# Generated from `grep -r "process.env." apps/web/src packages/core/src`, so it
# is the actual list rather than a remembered one. If you add a `process.env`
# read, add it here in the same commit — a key nobody knew was needed is
# indistinguishable from a broken feature.
#
# Copy to `apps/web/.env.local` for local development. On Vercel these go in
# Project Settings -> Environment Variables. Changing one there only takes
# effect on the next deployment.
#
# REQUIRED  — the app will not run without it
# GATED     — a feature stays off, or stays simulated, until it is set
# OPTIONAL  — has a working default

# --- Supabase -------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.

# REQUIRED
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# REQUIRED
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# REQUIRED. Server-only, never exposed to the browser. Creates accounts, reads
# the secret tables that have RLS on and no policies, and runs the cron and
# webhook endpoints, none of which have a user session.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Encryption -----------------------------------------------------------

# REQUIRED to connect a mailbox. Encrypts stored app passwords, and salts the
# IP hashes used to rate-limit the public enquiry form. Held here rather than
# in the database on purpose: a leaked service-role key alone should not open
# the studio's mailbox.
#
#   Generate with:  openssl rand -base64 32
LENSELLO_ENCRYPTION_KEY=""

# --- Access ---------------------------------------------------------------

# GATED. Sign-up at /signup is DISABLED while this is empty, and that is the
# safe default: any profile row grants access to the whole client book, so an
# ungated form on a public URL would hand the studio's data to whoever found it.
# Set it to a long random string and share it with people you want to join.
LENSELLO_SIGNUP_CODE=""

# --- AI -------------------------------------------------------------------

# GATED. Campaign copy, captions, and client reply drafting all self-disable
# and say why while this is empty. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=""
# OPTIONAL. Defaults to a current Claude model; set only to pin a specific one.
ANTHROPIC_MODEL=""

# --- Email ----------------------------------------------------------------
# Two options. Connecting a mailbox at /connections is the recommended one and
# needs no keys here — replies then leave from the studio's real address and
# thread properly. These are for the Postmark alternative.

# GATED. Postmark -> Servers -> your server -> API Tokens -> Server API token.
POSTMARK_SERVER_TOKEN=""
# GATED. The verified sender address replies come from.
LENSELLO_FROM_EMAIL=""
# GATED. Your own random string. Goes in the inbound webhook URL as ?secret=...
# Postmark does not sign inbound webhooks, so this IS the authentication —
# treat the whole URL as a credential. Inbound mail is refused while it is empty.
POSTMARK_WEBHOOK_SECRET=""
# OPTIONAL. Defaults to "outbound".
POSTMARK_MESSAGE_STREAM=""

# OPTIONAL. Where "a client wrote in" alerts go. Comma-separated. Defaults to
# every owner account's email address.
LENSELLO_NOTIFY_EMAIL=""

# --- Scheduling -----------------------------------------------------------

# GATED. Authenticates /api/cron/publish-scheduled, which publishes scheduled
# posts when their time arrives. The endpoint refuses every request while this
# is empty rather than defaulting to open.
#
#   Generate with:  openssl rand -base64 24
#
# Note: Vercel Hobby runs cron once per day. Minute-accurate scheduling needs
# Pro, or an external trigger hitting the endpoint with this as a bearer token.
CRON_SECRET=""

# --- Social ---------------------------------------------------------------

# GATED. Until these are set, social linking and messages are SIMULATED — the
# accounts, followers, and DMs you see are invented by the mock adapter and
# nothing reaches Instagram. See docs/CONNECTING_EMAIL_AND_INSTAGRAM.md.
#
# Only Instagram has a live adapter, and it is unverified — it has never run
# against Meta's API. Facebook, TikTok, and Pinterest remain mock-only.
META_APP_ID=""
META_APP_SECRET=""
# The Instagram business account id, shown on the connections page after the
# first successful link.
META_IG_USER_ID=""

# --- Advertising ----------------------------------------------------------

# GATED. Until these are set, the Ads module is SIMULATED end to end: launching
# an ad reaches nothing, and every spend, impression, click and lead figure is
# generated by the mock. The page says so rather than letting the numbers pass
# as real.
#
# The adapter is written and UNVERIFIED — it has never run against Meta's API.
#
# Note this is a SEPARATE approval from Instagram publishing: it needs a token
# with `ads_management` and its own App Review. META_APP_ID/SECRET alone are not
# enough.
META_AD_ACCOUNT_ID=""
META_ADS_ACCESS_TOKEN=""
# The Page ads are published as. Meta requires one on the creative.
META_PAGE_ID=""

# --- Calendar -------------------------------------------------------------

# OPTIONAL. Without these, confirming a gig records the booking against the
# built-in simulator and the gig page says so.
#
# Google Calendar, via a *service account* rather than signing in with Google.
# That is deliberate: the calendar scope is "sensitive", so an unverified app's
# sign-in tokens expire every seven days. A service account has no such limit —
# it is a robot account you share the calendar with, like a colleague.
#
# Setup, once:
#   1. console.cloud.google.com → new project → enable the Google Calendar API.
#   2. Credentials → Create credentials → Service account. Skip the optional
#      role and user steps.
#   3. Open it → Keys → Add key → Create new key → JSON. A file downloads.
#   4. From that file: "client_email" below, and "private_key" below.
#   5. In Google Calendar, open the studio calendar's settings → "Share with
#      specific people" → add the client_email address → permission
#      "Make changes to events". THIS STEP IS THE ONE PEOPLE MISS; without it
#      every request comes back "not found".
#   6. Same settings page → "Calendar ID" (an address ending in
#      @group.calendar.google.com, or your own address for a primary calendar).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The whole PEM block from the JSON file, quoted, newlines left as the literal
# \n they arrive as. Copy the value exactly as it appears between the quotes in
# the downloaded file.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID=""

# --- Money ----------------------------------------------------------------

# OPTIONAL. Defaults to GBP / en-GB, because the studio operates in the UK.
# NEXT_PUBLIC_ because prices render in the browser as well as on the server —
# without the prefix the same fee could display differently in two places.
#
# This is not cosmetic: the contract template quotes the fee through this, so
# the currency here is the currency a client agrees to pay.
NEXT_PUBLIC_LENSELLO_CURRENCY="GBP"
NEXT_PUBLIC_LENSELLO_LOCALE="en-GB"

# OPTIONAL. Used on contracts and as the sender name. Defaults to
# "Lensello Photography".
LENSELLO_STUDIO_NAME=""

# OPTIONAL. The deployment's own public URL, used to build payment return
# links. Defaults to the production alias.
LENSELLO_PUBLIC_URL=""

# --- Payments -------------------------------------------------------------

# GATED. Deposits and balances are SIMULATED until this is set — the mock
# marks a request paid on the second check, which is fine for a demo and a lie
# in production. Stripe dashboard -> Developers -> API keys.
#
# Cards go through Stripe rather than being handled here on purpose: taking
# them directly would put the studio in PCI scope, which is a compliance
# programme, not a feature.
STRIPE_SECRET_KEY=""

# GATED. Signing secret for the settlement webhook, from
# Developers -> Webhooks -> your endpoint. Point it at:
#   https://your-deployment/api/webhooks/stripe
# subscribed to `checkout.session.completed`.
#
# The endpoint refuses every request while this is empty. It marks deposits
# paid, so an unverified caller could mark every gig settled and the studio
# would ship work for money it never received.
STRIPE_WEBHOOK_SECRET=""

# --- Mode -----------------------------------------------------------------

# OPTIONAL. "mock" (default) or "live".
#
# This does NOT turn everything on. It means "stop pretending": in live mode a
# capability with no configured adapter THROWS when used rather than returning
# invented data, so a half-configured deploy cannot look like it is posting to
# Instagram when it isn't. Capabilities resolve independently — email can be
# live while social is not.
#
# Still simulated in every mode, because no live adapter exists: calendar sync,
# and every social platform except Instagram.
LENSELLO_INTEGRATION_MODE="mock"
