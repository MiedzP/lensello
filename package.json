{
  "name": "lensello",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > supabase/types.generated.ts",
    "db:types:check": "node scripts/check-db-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
